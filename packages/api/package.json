{
  "name": "@auction/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx src/infrastructure/database/migrations/run.ts",
    "pii:encrypt-existing": "tsx src/scripts/encrypt-existing-pii.ts",
    "smoke": "node scripts/smoke.mjs",
    "test:endpoints": "node scripts/test-all-endpoints.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "echo \"no lint yet\""
  },
  "dependencies": {
    "@auction/shared": "workspace:*",
    "@napi-rs/canvas": "^1.0.10",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "file-type": "^22.1.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^18.0.14",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.18.0",
    "telegraf": "^4.16.3",
    "tesseract.js": "^7.0.0",
    "twilio": "^5.13.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.2",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
