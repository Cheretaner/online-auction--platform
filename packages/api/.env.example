NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auction
DATABASE_SSL=false
DATABASE_POOL_MAX=10
JWT_SECRET=dev-secret-change-me-in-production-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=auction-api
JWT_AUDIENCE=auction-web
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
STORAGE_DRIVER=filesystem
STORAGE_DIR=./data/storage
MAIL_FROM=noreply@localhost
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# AI provider chain: Gemini first, OpenRouter as automatic fallback,
# then a deterministic stub so the platform never blocks on AI.
# "auto" uses whichever provider below has an API key set.
AI_PROVIDER=auto
AI_TIMEOUT_MS=8000

# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-flash-latest

# OpenRouter free tier: https://openrouter.ai/keys (pick a ":free" model)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=AI-Powered Transparent Online Auction System
IDEMPOTENCY_TTL_MS=86400000
REQUEST_BODY_LIMIT=2mb

# Telegram Bot & Channel integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING=false
WEB_BASE_URL=http://localhost:5173
