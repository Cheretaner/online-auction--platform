NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auction
DATABASE_SSL=false
DATABASE_POOL_MAX=10
JWT_SECRET=dev-secret-change-me-in-production-32chars
# Separate secret for refresh tokens (falls back to JWT_SECRET + suffix).
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=auction-api
JWT_AUDIENCE=auction-web
# Production refuses "*": list the web origin(s), comma separated.
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# Number of reverse proxies in front of the API (1 behind nginx, 0 when exposed directly).
TRUST_PROXY_HOPS=0

# The only address promoted to super_admin at sign-up. REQUIRED in
# production. In development, leaving it empty promotes the first account.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# Pepper for hashing bidder IPs in the audit trail (falls back to JWT_SECRET).
IP_HASH_PEPPER=

# Apply pending migrations at startup (advisory-locked; safe with several instances).
RUN_MIGRATIONS_ON_BOOT=false
# TLS to a managed database: PEM contents of the provider's CA certificate.
# DATABASE_CA_CERT=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Lifecycle sweep interval (scheduled -> live -> closed).
AUCTION_TICK_MS=10000
STORAGE_DRIVER=filesystem
STORAGE_DIR=./data/storage
# Configure a real sender on your verified sending domain in production.
MAIL_FROM=notifications@example.com
# Local development may omit SMTP_HOST; email is logged to the API console.
# Production requires SMTP_HOST and verifies the transport before serving.
# Port 587: SMTP_SECURE=false (STARTTLS). Port 465: SMTP_SECURE=true.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# AI provider chain: Gemini first, OpenRouter as automatic fallback,
# then a deterministic stub so the platform never blocks on AI.
# "auto" uses whichever provider below has an API key set.
AI_PROVIDER=auto
AI_TIMEOUT_MS=8000

# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-flash-latest

# OpenRouter free tier: https://openrouter.ai/keys (pick a ":free" model)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=AI-Powered Transparent Online Auction System
IDEMPOTENCY_TTL_MS=86400000
REQUEST_BODY_LIMIT=2mb

# Telegram Bot & Channel integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Local development: use polling. Production should prefer a public HTTPS
# TELEGRAM_WEBHOOK_URL and a long random TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_POLLING=true
WEB_BASE_URL=http://localhost:5173
