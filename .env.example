# Core
# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=info
# BOOTSTRAP_SUPER_ADMIN_EMAIL=
# AUCTION_TICK_MS=10000
# IDEMPOTENCY_TTL_MS=86400000
# REQUEST_BODY_LIMIT=2mb
# WEB_BASE_URL=http://localhost:5173

# Database (Required in production)
# DATABASE_URL=
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_CA_CERT=
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# Auth/JWT
# JWT_SECRET=dev-secret-change-me-in-production-32chars
# JWT_REFRESH_SECRET=
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# JWT_ISSUER=auction-api
# JWT_AUDIENCE=auction-web
# GOOGLE_CLIENT_ID=
# IP_HASH_PEPPER=

# CORS
# CORS_ORIGIN=*

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=10
# SUBMISSION_RATE_WINDOW_MS=900000
# SUBMISSION_RATE_LIMIT_MAX=5

# Storage
# STORAGE_DRIVER=filesystem
# STORAGE_DIR=./data/storage
# FILE_SCAN_ENABLED=false
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# FILE_SCAN_TIMEOUT_MS=15000
# SETTLEMENT_DUE_HOURS=72

# SMTP (required in production; use a real sender on your domain)
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=notifications@example.com

# AI
# AI_PROVIDER=auto
# AI_TIMEOUT_MS=15000
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-flash-latest
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_SITE_NAME=AI-Powered Transparent Online Auction System

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_CHANNEL_ID=
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_API_ROOT=
# TELEGRAM_POLLING=false

# Chapa hosted checkout; configure both credentials to enable payment flows.
# CHAPA_SECRET_KEY=
# CHAPA_PUBLIC_KEY=
# CHAPA_WEBHOOK_SECRET=

# Use independent random 32+ character secrets; required in production.
# PII_ENCRYPTION_KEY=
# PII_HASH_SECRET=

# Deployment
# TRUST_PROXY_HOPS=0
# RUN_MIGRATIONS_ON_BOOT=true
